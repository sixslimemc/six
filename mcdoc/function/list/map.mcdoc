// Applies a *transform* function over all *items*.

use super::super::super::def::TransformerApi
use super::super::super::def::TransformerCommand

type In<TIn, TOut> = struct {
    list: [TIn],
    /// If unspecified, will be the identity function (*items* does not change).
    transform?: TransformerCommand,
}

type Out<TIn, TOut> = struct {
    result: [TOut],
}

type Return = 1

type Api<TIn, TOut> = TransformerApi<TIn, TOut>