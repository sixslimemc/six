use super::super::super::def::AnyStruct

struct In {
    struc: AnyStruct,
}

struct Out {
    result: [KeyValuePair],
}

struct KeyValuePair {
    key: string,
    value: any,
    /// 'key' can safely be surrounded with this type of quote when used in a macro.
    key_quote_type: ("'" | "\"")
}

type Return = 1