
use super::super::super::def::SetEqualityComparerApi
use super::super::super::def::SetEqualityComparerCommand

type In<Ta, Tb> = struct {
    a: [Ta],
    b: [Tb],
    by?: SetEqualityComparerCommand,
    // if true, preserves original order of elements in <a> and <b>, prioritizing left-most elements.
    ordered?: boolean
}

type Out<Ta, Tb> = struct {
    difference: ComparisonResult<Ta, Tb>,
    intersection: ComparisonResult<Ta, Tb>,
}

type ComparisonResult<Ta, Tb> = struct {
    a: [Ta],
    b: [Tb],
}
type Api<Ta, Tb> = SetEqualityComparerApi<(Ta | Tb)>