// Removes duplicates from *items*, returning a set.
// order is preserved, left-most items prioritized.

use super::super::super::def::SetEqualityComparerApi
use super::super::super::def::SetEqualityComparerCommand

type In<T> = struct {
    items: [T],
    // Use the result of this lambda on each element to compare equality.
    by?: SetEqualityComparerCommand,
}

type Out<T> = struct {
    result: [T]
}

type Api<T> = SetEqualityComparerApi<T>

/// Count of duplicates removed.
type Return = int @ 0..