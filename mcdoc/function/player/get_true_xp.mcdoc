// AS [player]

struct In {

}

struct Out {
    result: int,
}

type Return = (ReturnSuccess | ReturnError)
/// Equals >result<.
type ReturnSuccess = int @ 0..

enum(int) ReturnError {
    /// true xp is larger than the integer limit.
    /// (>result< will be equal to the integer limit if this is returned.)
    TooLarge = -1,
}